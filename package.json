{
  "name": "my-rag",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "scripts": {
    "lint": "eslint src --ext .ts",
    "build": "tsc -p tsconfig.prod.json && npm run copy-assets",
    "buildWithSource": "tsc -p tsconfig.dev.json && npm run copy-assets",
    "copy-assets": "cpy \"src/**/*.{json,md}\" dist && cpy \"models/**/*\" \"dist/models\"",
    "start": "node dist/server.js",
    "client": "tsc && node dist/client.js",
    "dev": "nodemon",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@huggingface/transformers": "^3.8.1",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.8.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dompurify": "^3.3.3",
    "express": "^5.2.1",
    "jsdom": "^29.0.1",
    "multer": "^2.1.1",
    "onnxruntime-node": "^1.24.3",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "sentence-splitter": "^5.0.0",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0",
    "vectra": "^0.12.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.1.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "prettier": {
    "htmlWhitespaceSensitivity": "ignore",
    "tabWidth": 4,
    "trailingComma": "none",
    "useTabs": true,
    "bracketSpacing": true,
    "bracketSameLine": false,
    "singleAttributePerLine": true,
    "endOfLine": "crlf",
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  }
}
