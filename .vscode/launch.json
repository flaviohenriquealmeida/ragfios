{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Launch Program",
			"program": "${workspaceFolder}/dist/server.js",
			"preLaunchTask": "buildWithSource",
			"outFiles": ["${workspaceFolder}/dist/**/*.js"],
			"sourceMaps": true,
			"cwd": "${workspaceFolder}",
			"runtimeArgs": ["--enable-source-maps"]
		}
	]
}

